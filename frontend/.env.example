# Copy to .env.local to override. VITE_ variables are bundled into the app and public: never put secrets here.

# API base path used by src/services/api.ts (same-site only; see ADR 004 and FRONTEND_PLAN.md F2 Q1).
VITE_API_BASE_URL=/api/v1

# Rails server the Vite dev proxy forwards /api to (dev server only; not bundled).
VITE_PROXY_TARGET=http://localhost:3000
